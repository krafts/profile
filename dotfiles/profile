# ssh agent (macOS and Linux): one agent shared by all shells on a fixed socket,
# started only if no agent answers on it. ssh-add -l exits 2 when it cannot
# reach an agent; a socket file left by a dead agent is removed so a new agent
# can bind to it.
# Never start an agent per shell: they never exit and pile up.
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
ssh-add -l >/dev/null 2>&1
if [ $? -eq 2 ]; then
  rm -f "$SSH_AUTH_SOCK"
  ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null
fi



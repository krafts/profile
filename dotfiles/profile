#
# _starship_init_filter patches starship's bash init script before it is cached
# (see cached_init), removing starship processes that would otherwise run on
# every prompt or every shell start. Each process start is slow here (Defender
# scans every exec, often ~0.7s), so fewer starts means a faster shell.
# It reads the init script on stdin and writes the patched script to stdout.
#
# 1. Command timing (sed): starship times each command by running
#    `starship time` twice per prompt: in PS0 / the DEBUG trap before the
#    command, and in starship_precmd after it. Both are replaced with bash's
#    built-in $EPOCHREALTIME (seconds.microseconds) converted to milliseconds,
#    which is what `starship time` prints. ${EPOCHREALTIME//[!0-9]/} strips the
#    decimal separator (locale independent), giving microseconds; / 1000 = ms.
#    - `$(... starship time)` becomes `$(( ${EPOCHREALTIME//[!0-9]/} / 1000 ))`.
#    - In PS0 the value is assigned inside an existing $(( )), so
#      `"$(starship_preexec_ps0)"` becomes just `${EPOCHREALTIME//[!0-9]/}/1000`
#      (no subshell at all).
#
# 2. Continuation prompt (bash loop): the init script sets PS2, the prompt
#    shown when a command continues onto another line (open quote, trailing
#    `\`, unfinished if/for), with
#      PS2="$(/path/to/starship prompt --continuation)"
#    which starts starship in every new shell, although its output only depends
#    on the starship config (`continuation_prompt`, default a grey "∙ ").
#    The command is run once here instead and its output is written into the
#    cache as a literal, e.g. PS2=$'\\[\E[90m\\]∙\\[\E[0m\\] '.
#    printf %q quotes the value so escape characters and backslashes survive.
#    If starship fails, the original line is kept, so PS2 still works.
#    Note: the cache is not rebuilt when starship.toml changes; after changing
#    `continuation_prompt`, run: rm -rf ~/.cache/shell-init
#    A bash loop is used rather than sed because the value contains escape
#    characters and backslashes that sed would need escaped in a replacement.
function _starship_init_filter() {
  local ps2 line
  ps2=$(starship prompt --continuation) || ps2=

  sed -E \
    -e 's#\$\([^()]*starship time\)#$(( ${EPOCHREALTIME//[!0-9]/} / 1000 ))#g' \
    -e 's#"\$\(starship_preexec_ps0\)"#${EPOCHREALTIME//[!0-9]/}/1000#' |
  while IFS= read -r line || [ -n "$line" ]; do
    if [ -n "$ps2" ] && [[ $line == 'PS2="$('*'starship prompt --continuation)"' ]]; then
      printf 'PS2=%q\n' "$ps2"
    else
      printf '%s\n' "$line"
    fi
  done
}
cached_init --filter _starship_init_filter starship init bash --print-full-init


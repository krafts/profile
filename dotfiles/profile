# starship (after PROMPT_COMMAND is set, so starship wraps it instead of being overwritten)
export STARSHIP_CONFIG=$HOME/.config/starship/starship.toml
# Use bash's $EPOCHREALTIME (ms) instead of exec'ing `starship time` 2x per prompt;
# process exec is slow here (Defender scans every exec).
function _starship_init_filter() {
  sed -E \
    -e 's#\$\([^()]*starship time\)#$(( ${EPOCHREALTIME//[!0-9]/} / 1000 ))#g' \
    -e 's#"\$\(starship_preexec_ps0\)"#${EPOCHREALTIME//[!0-9]/}/1000#'
}
cached_init --filter _starship_init_filter starship init bash --print-full-init


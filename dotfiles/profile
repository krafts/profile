# Source a tool's shell init from a cache, regenerating it only when the tool's
# binary or this file is newer than the cache. Every exec is slow here
# (Defender scans each one), so running each init on every shell start adds up.
# usage: cached_init [--filter <func>] <command> [args...]
#   The cache is named after <command>. --filter pipes the init output through
#   <func> before caching it.
# Changes to a tool's own config are not detected; to regenerate all caches:
#   rm -rf ~/.cache/shell-init
function cached_init() {
    local - filter=cat bin
    set -o pipefail  # fail if the init command fails, not just the filter
    if [ "$1" = --filter ]; then filter=$2; shift 2; fi
    bin=$(type -P "$1") || return 0
    local dir="${XDG_CACHE_HOME:-$HOME/.cache}/shell-init"
    local cache="$dir/$1.bash"
    if [ ! -s "$cache" ] || [ "$bin" -nt "$cache" ] || [ "${BASH_SOURCE[0]}" -nt "$cache" ]; then
        mkdir -p "$dir"
        if "$@" 2>/dev/null | "$filter" >"$cache.$$" && [ -s "$cache.$$" ]; then
            mv -f "$cache.$$" "$cache"
        else
            rm -f "$cache.$$"
            return 0
        fi
    fi
    . "$cache"
}

